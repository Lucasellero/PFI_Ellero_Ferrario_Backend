__pycache__/
*.pyc
.venv/
venv/
*.db
*.pt
.env
.DS_Store
runner_state/

# Paquete de deploy de cloud/ a Elastic Beanstalk (se arma localmente antes de
# subir, ver "Desplegar a AWS" en cloud/README.md) — artefacto de build, no
# código fuente.
deploy.zip
deploy_bundle/
# Scratch local del deploy a AWS (contraseñas de RDS, DATABASE_URL armado, logs) —
# nunca tiene que subirse al repo, ver mismo "Desplegar a AWS".
cloud/.aws_*
cloud/.backend_*.log

# Config/cache local de Claude Code (herramienta, no código del proyecto)
.claude/
.agents/
skills-lock.json

# Dataset de video: no versionar los archivos, solo la estructura, el README
# y el ground truth derivado (Fall.csv, kaggle_data.csv, etc.)
videos/**/*.mp4
videos/**/*.avi
videos/**/*.mov

# CAUCAFall: dataset crudo (frames png + labels YOLO por frame, ~40k archivos)
# y material del paper — se regenera Fall.csv con build_caucafall_groundtruth.py
videos/CAUCAFall/CAUCAFall/**/*.png
videos/CAUCAFall/CAUCAFall/**/*.txt
videos/CAUCAFall/*.xlsx
videos/CAUCAFall/*.jpeg

# Dataset de eventos CASAS (labeled_data.zip): ~1.2 GB de CSV crudos.
# Versionar solo el ETL y activity_map.py; los eventos derivados se regeneran
# con dataset_events/etl.py. Se versiona events/_manifest.json (resumen chico).
dataset_events/labeled/
dataset_events/events/*.jsonl
dataset_events/events/*.parquet
dataset_events/*.db
# Zip portable de events/ (útil como snapshot a mano, ej. para el smoke test de
# cloud/app/rutina.py), mismo criterio que lo de arriba: se regenera, no se versiona.
dataset_events/events.zip

# frames/{cam_id}.jpg: preview en vivo que escribe runner/camera_worker.py por cada cámara
# mientras corre — no es contenido, se pisa solo en cada corrida. Las capturas de abajo son
# imágenes de demo elegidas a mano para el informe/mockups, sí se versionan.
frames/*.jpg
!frames/CAIDA_1.jpg
!frames/CAIDA_2.jpg
!frames/CAMINAR.jpg
!frames/COCINANDO.jpg
!frames/COMIENDO.jpg
!frames/DESCANSANDO.jpg
!frames/TOMANDO_AGUA.jpg
!frames/webcam.jpg

# Cache de features derivado del dataset (se regenera con evaluate_posture.py)
vision/posture_features.csv
vision/fall_calibration.csv
vision/immobility_calibration.csv
vision/fall_descriptors_cache.pkl
vision/recalibrate_results.pkl
vision/sweep_immobility_soft_results.pkl
vision/calibrate_immobility_core_raw.pkl
vision/diagnose_series_*.pkl
vision/diagnose_acostado_*.pkl
vision/fall_confirmation_scores.csv
vision/fall_confirmation_onnx_check.csv
vision/fall_confirmation_embeddings.npz
vision/*.log
vlm/clip_features*.npz
vlm/*.log
vlm/omnifall_features.npz
vlm/caucafall_omnifall.csv
vlm/models/*
!vlm/models/category_probe.npz
vlm/models_*/
fusion/models/
fusion/dataset_features.npz
fusion/*_features.npz
fusion/fall_windows.npz
fusion/fall_windows_cache.pkl

# Sets de evaluación sintética de baseline/ (se regeneran con inject_*.py / evaluate_*.py)
baseline/synthetic_eval/

# Videos anotados de evaluation/ (se regeneran con annotate_video.py)
evaluation/output/
*.onnx
*.onnx.data

# Cache de pytest (ver pytest.ini)
.pytest_cache/
