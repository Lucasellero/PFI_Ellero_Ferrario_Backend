videos/**/*.mov

# CAUCAFall: dataset crudo (frames png + labels YOLO por frame, ~40k archivos)
# y material del paper — se regenera Fall.csv con build_caucafall_groundtruth.py
videos/CAUCAFall/CAUCAFall/**/*.png
videos/CAUCAFall/CAUCAFall/**/*.txt
videos/CAUCAFall/*.xlsx
videos/CAUCAFall/*.jpeg

